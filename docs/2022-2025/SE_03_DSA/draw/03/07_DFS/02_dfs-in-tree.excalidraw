    {
      "id": "bm5j6EZf-dQu5NYympSRw",
      "type": "text",
      "x": 258,
      "y": 354,
      "width": 438.6363636363635,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2m",
      "roundness": null,
      "seed": 912514383,
      "version": 525,
      "versionNonce": 1505738081,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789251759831,
      "created": 1789248635260,
      "link": null,
      "locked": false,
      "text": "def dfs(node): # DFS on binary tree\n  if  node is None:\n    return # prevent from going beyond leaf nodes\n\n  # process the current node\n  dfs(node.left)\n\n  dfs(node.right)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def dfs(node): # DFS on binary tree\n  if  node is None:\n    return # prevent from going beyond leaf nodes\n\n  # process the current node\n  dfs(node.left)\n\n  dfs(node.right)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
