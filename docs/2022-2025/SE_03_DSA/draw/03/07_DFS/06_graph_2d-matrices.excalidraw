      "seed": 1214684499,
      "version": 144,
      "versionNonce": 1341567027,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789513044658,
      "created": 1789511682879,
      "link": null,
      "locked": false,
      "text": "**conditions:**\n- The graph must contain **no cycles.**\n- There should be a **single connected component**\n  - if we start from any node, we should be able to reach all other nodes.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**conditions:**\n- The graph must contain **no cycles.**\n- There should be a **single connected component**\n  - if we start from any node, we should be able to reach all other nodes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Wq6rRL6PmPL1_F_UKTjDu",
      "type": "text",
      "x": 508,
      "y": 497,
      "width": 457.599365234375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 178311347,
      "version": 144,
      "versionNonce": 1412554877,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1789513044658,
      "created": 1789512038753,
      "link": null,
      "locked": false,
      "text": "undirected graph\n- 0 -- 1 \n- then 1 -- 0, is not cycle, \n    it simply tells from where it come from, parent.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "undirected graph\n- 0 -- 1 \n- then 1 -- 0, is not cycle, \n    it simply tells from where it come from, parent.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
