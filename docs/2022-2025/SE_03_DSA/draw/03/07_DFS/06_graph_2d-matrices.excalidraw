    {
      "id": "PKZi0a_InKWa4-GYlC8Ug",
      "type": "text",
      "x": 493.4288939051919,
      "y": 92.7629796839729,
      "width": 651.1990966796875,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0M",
