    {
      "id": "PXLhNGMFb8GW2PncIS4Ke",
      "type": "text",
      "x": 783,
      "y": 355,
      "width": 536.7992553710938,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7k",
      "roundness": null,
      "seed": 953469551,
      "version": 147,
      "versionNonce": 229908975,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789250509711,
      "created": 1789250164977,
      "link": null,
      "locked": false,
      "text": "A binary tree is balanced \n- if the height of the left and right subtrees of every node \n- differ by at most 1. ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A binary tree is balanced \n- if the height of the left and right subtrees of every node \n- differ by at most 1. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GYNkB9pfOjEFLVnYDpx1_",
      "type": "text",
      "x": 1147,
      "y": 584,
      "width": 395.99945068359375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7l",
      "roundness": null,
      "seed": 21472367,
      "version": 114,
      "versionNonce": 763470927,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789250647417,
      "created": 1789250209340,
      "link": null,
      "locked": false,
      "text": "A binary tree is complete \n- if every level, except possibly the last, \n  is completely filled, \n- and all nodes are as far left as possible. ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A binary tree is complete \n- if every level, except possibly the last, \n  is completely filled, \n- and all nodes are as far left as possible. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
