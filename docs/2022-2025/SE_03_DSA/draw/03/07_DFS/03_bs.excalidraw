      "isDeleted": true,
      "boundElements": null,
      "updated": 1789249431934,
      "created": 1789248635260,
      "link": null,
      "locked": false,
      "text": "def dfs(node): # DFS on binary tree\n  if  node is None:\n    return # prevent from going beyond leaf nodes\n\n  # process the current node\n  dfs(node.left)\n  dfs(node.right)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def dfs(node): # DFS on binary tree\n  if  node is None:\n    return # prevent from going beyond leaf nodes\n\n  # process the current node\n  dfs(node.left)\n  dfs(node.right)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
