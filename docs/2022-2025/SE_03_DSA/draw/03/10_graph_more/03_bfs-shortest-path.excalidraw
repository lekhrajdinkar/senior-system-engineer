      "link": null,
      "locked": false,
      "text": "    while queue:\n        node = queue.popleft()\n        for neighbor in graph[node]:\n            if distances[neighbor] == float('inf'):\n                distances[neighbor] = distances[node] + 1\n                queue.append(neighbor)\n    return distances",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
