    {
      "id": "pzMAdJNfz0kvFH5Qrd_hh",
      "type": "text",
      "x": 909,
      "y": 242.5,
      "width": 844.798828125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 1932448684,
      "version": 56,
      "versionNonce": 415266349,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791362539012,
      "created": 1790282800935,
      "link": null,
      "locked": false,
      "text": " while heap:\n        dist2Node, node = heapq.heappop(heap) # heap will pop next smallest\n        if dist2Node > distances[node]: continue # ignore long path\n        \n        # explore short path further\n        for neighbor, weight in graph[node]:\n            dist2neighbor = dist2Node + weight\n            if dist2neighbor < distances[neighbor]:\n                distances[neighbor] = dist2neighbor # update result\n                heapq.heappush(heap,(dist2neighbor, neighbor)) # so that can further explore it.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " while heap:\n        dist2Node, node = heapq.heappop(heap) # heap will pop next smallest\n        if dist2Node > distances[node]: continue # ignore long path\n        \n        # explore short path further\n        for neighbor, weight in graph[node]:\n            dist2neighbor = dist2Node + weight\n            if dist2neighbor < distances[neighbor]:\n                distances[neighbor] = dist2neighbor # update result\n                heapq.heappush(heap,(dist2neighbor, neighbor)) # so that can further explore it.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
